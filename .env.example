# Environment variables. The real values live in Vercel; the easiest way to get
# them locally is `vercel env pull .env.local` (see README).
#
# Firebase configuration
# Or copy this file to .env.local and fill in your values from the Firebase console.
# These VITE_* variables are bundled into the client build; Firebase security
# depends entirely on your Firebase Security Rules, not on keeping these values secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Parent domain that embeds the customer order page in an iframe.
# Set to your business website origin (e.g. https://empanadasyrose.com).
# If not set, postMessage falls back to '*' (less secure).
VITE_EMBED_ORIGIN=

# Origin allowed to call the serverless functions in api/ (set in Vercel only).
# Defaults to https://ebr-order-app.vercel.app if unset.
ALLOWED_ORIGIN=

# Google Gemini API key (used by the serverless proxy at api/gemini-proxy.js)
# Set this in your Vercel environment variables — do NOT prefix with VITE_
GEMINI_API_KEY=

# Resend email service (set in Vercel environment variables only)
RESEND_API_KEY=
RESEND_FROM=
OWNER_EMAIL=

# Shared secret for internal API calls (generate a long random string, e.g. openssl rand -hex 32)
# VITE_INTERNAL_API_SECRET is sent as the X-Internal-Secret header from the browser.
# INTERNAL_API_SECRET is the server-side variable that validates it (set in Vercel only).
# Both must be set to the same value.
VITE_INTERNAL_API_SECRET=
INTERNAL_API_SECRET=
